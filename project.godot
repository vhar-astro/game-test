; Infinity Reality — Godot 4.7.2, Linux, GDScript, Mobile/Vulkan.
config_version=5

[application]
config/name="Infinity Reality"
config/description="Explore the Crystal Forest. Follow the light. Find what remains."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[internationalization]
locale/translations=PackedStringArray("res://assets/localization.en.translation", "res://assets/localization.ru.translation")

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[audio]
driver/enable_input=false

[debug]
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/infinity.log"
file_logging/max_log_files=3
